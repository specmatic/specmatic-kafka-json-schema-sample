{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewOrders",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "orderItems"],
  "properties": {
    "id": {"type": "integer", "minimum": 1, "maximum": 100},
    "orderItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "quantity", "price"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string", "minLength": 2, "maxLength": 10, "pattern": "^[A-Za-z]{2,10}$"},
          "quantity": {"type": "integer"},
          "price": {"type": "integer", "minimum": 1000}
        }
      }
    }
  }
}
